{
  "name": "crm-eurovia",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @crm/api prisma:generate",
    "db:push": "pnpm --filter @crm/api prisma:push",
    "db:migrate": "pnpm --filter @crm/api prisma:migrate",
    "db:seed": "pnpm --filter @crm/api prisma:seed",
    "db:studio": "pnpm --filter @crm/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@sentry/node": "^11.7.0",
    "@sentry/tracing": "^7.120.4",
    "playwright": "^1.64.0"
  }
}
