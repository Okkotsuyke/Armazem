# CRM EUROVIA - Frontend Environment Variables Example
# Copie para apps/web/.env.local

# ===========================================
# SUPABASE
# Pegue os valores em:
#   https://supabase.com/dashboard/project/dfqpirazzyleslhzegkz/settings/api
# - Project URL            → NEXT_PUBLIC_SUPABASE_URL
# - anon / public key      → NEXT_PUBLIC_SUPABASE_ANON_KEY
# (A Vercel precisa dessas duas vars em production, preview e development.)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ===========================================
# SENTRY
# ===========================================
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx@xxxxxxxx.ingest.sentry.io/xxxxxxx"

# ===========================================
# API
# ===========================================
# Em produção, aponta para API Vercel ou Cloudflare
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ===========================================
# APP
# ===========================================
NEXT_PUBLIC_APP_URL="https://crm-eurovia.com"
NEXT_PUBLIC_APP_NAME="CRM EUROVIA"
