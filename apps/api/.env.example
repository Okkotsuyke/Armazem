# ============================================================================
# CRM EUROVIA - API Environment Variables
# Copie para .env (dev) e configure os valores correspondentes na Vercel (prod)
# ============================================================================

# --- Banco de Dados (Supabase) -----------------------------------------------
# Conexão direta (serverless) - porta 6543 com pgbouncer
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Conexão transacional (migrations) - porta 5432
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Autenticação (JWT próprio) ----------------------------------------------
# IMPORTANTE: em prod, gere com `openssl rand -base64 48` e armazene nos
# Vercel Encrypted Env Vars. NUNCA use o valor de exemplo.
JWT_SECRET="crm-eurovia-jwt-secret-change-in-production-use-at-least-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Supabase Auth (cliente SSR no web) --------------------------------------
# Valores públicos (NEXT_PUBLIC_*) vão em apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."

# --- Syonet (CRM da empresa) -------------------------------------------------
SYONET_URL="https://viasul.syonet.com"
SYONET_USERNAME="seu.usuario"
SYONET_PASSWORD="sua.senha"
# false = mock (apenas dev), true = Playwright real (produção)
SYONET_USE_REAL="true"
# true = Playwright invisível; false = navegador visível (debug)
SYONET_HEADLESS="true"

# --- Sync Scheduler ----------------------------------------------------------
# Master switch do agendador interno (só usado fora da Vercel)
SYNC_ENABLED="true"
# Documentação: Vercel Cron é a fonte da verdade em prod
# vercel.json: [{ "path": "/api/cron/sync", "schedule": "*/15 * * * *" }]

# --- Sentry (error tracking) -------------------------------------------------
SENTRY_DSN="https://[KEY]@[ORG].ingest.sentry.io/[PROJECT]"
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="sua-organizacao"
SENTRY_PROJECT="crm-eurovia"

# --- Resend (e-mail transacional) --------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="CRM EUROVIA <noreply@eurovia.com.br>"

# --- Cloudflare R2 / DNS -----------------------------------------------------
CLOUDFLARE_ACCOUNT_ID="..."
CLOUDFLARE_API_TOKEN="..."

# --- Servidor ---------------------------------------------------------------
NODE_ENV="development"
PORT="3001"
# URL pública do frontend (para CORS e redirects)
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
