# ===========================================
# CRM EUROVIA - Environment Variables Example
# Copie para .env e preencha os valores
# ===========================================

# ===========================================
# SUPABASE
# ===========================================
# Obtenha em: https://supabase.com/dashboard/project/_/settings/api
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:postgres.[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ===========================================
# RESEND (Email Transacional)
# ===========================================
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# ===========================================
# SENTRY (Monitoramento de Erros)
# ===========================================
# Obtenha em: https://sentry.io/settings/[org]/projects/[project]/keys/
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx@xxxxxxxx.ingest.sentry.io/xxxxxxx"
SENTRY_AUTH_TOKEN="sntrys_xxxxxxxxxxxxxxxxxxxx"
SENTRY_ORG="sua-organizacao"
SENTRY_PROJECT="crm-eurovia"

# ===========================================
# SYONET (CRM da Empresa - Mantém scraping)
# ===========================================
SYONET_URL="https://viasul.syonet.com"
SYONET_USERNAME="seu.usuario"
SYONET_PASSWORD="sua.senha"

# ===========================================
# SERVIDOR
# ===========================================
NODE_ENV="development"
PORT="3001"

# ===========================================
# JWT (Substituir por Supabase Auth)
# ===========================================
# JWT_SECRET será descontinuado - usar Supabase Auth
# JWT_SECRET="sua-chave-secreta-minimo-32-caracteres"
# JWT_EXPIRES_IN="7d"
# JWT_REFRESH_EXPIRES_IN="30d"
